{
  "name": "dentflow-clinical-guardrails",
  "version": "1.0.0",
  "description": "Deterministic clinical triage engine, FDI dental notation parser, and chair rescue priority queue for dental clinics",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "dental",
    "dentistry",
    "triage",
    "guardrails",
    "fdi",
    "iso-3950",
    "healthtech",
    "clinical",
    "whatsapp"
  ],
  "author": "DentFlow HealthTech",
  "license": "MIT",
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
